# YG UniLUX environment variables.
# Copy to .env.local for local development and fill in real values there.
# Never commit real values. Never prefix a secret with NEXT_PUBLIC_.
# Every key is read and validated only in src/lib/env.ts, and only when the
# feature that needs it runs, so an empty value is fine until then.

# MongoDB Atlas connection string. It must name the database after the host,
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yg_unilux?retryWrites=true&w=majority
# (Atlas's "Connect" dialog leaves it out; without it everything lands in "test").
# Use a different database name (or cluster) for Preview and Production.
MONGODB_URI=
# Auth.js session signing secret, at least 32 random characters (openssl rand -base64 32).
AUTH_SECRET=
# Public base URL for auth callbacks; optional on Vercel, e.g. http://localhost:3000 locally.
AUTH_URL=
# Cloudinary for public product images, as one URL: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Copy it from the Cloudinary console (API Keys -> "API environment variable"), value only, without "CLOUDINARY_URL=".
# The API key and secret are used only server-side for signed uploads; the cloud name also limits next/image to this account.
CLOUDINARY_URL=
# Cloudflare account ID that owns the private R2 bucket.
R2_ACCOUNT_ID=
# R2 API token access key ID, scoped to the private bucket.
R2_ACCESS_KEY_ID=
# R2 API token secret access key.
R2_SECRET_ACCESS_KEY=
# Private R2 bucket name for datasheets and whistleblower attachments (no public access).
R2_BUCKET=
# Resend API key for transactional email.
RESEND_API_KEY=
# Sender for outgoing email, e.g. "YG UniLUX <no-reply@example.com>" (domain verified in Resend).
# Until a domain is verified, use Resend's test sender, e.g. "YG UniLUX <onboarding@resend.dev>";
# Resend then delivers ONLY to the Resend account owner's own address, and every other recipient fails.
EMAIL_FROM=
# Company inbox for whistleblower alerts, named reports and access-request alerts.
COMPANY_EMAIL=
# "true" to block mainland China (country CN only) in proxy.ts; empty or "false" = off.
GEO_BLOCK_ENABLED=
# Whistleblower AES-256-GCM key: base64 of 32 random bytes (openssl rand -base64 32). Back it up; losing it loses the data.
WHISTLEBLOWER_ENC_KEY=
# Shared secret Vercel Cron sends as a Bearer token, at least 32 random characters.
CRON_SECRET=
# Secret key for scrambling visitors' IP addresses (HMAC-SHA256) in the sign-in rate limit, at least
# 32 random characters (openssl rand -base64 32). Must differ from AUTH_SECRET. Rotating it only resets
# 15-minute sign-in counters. Never used on whistleblower pages, which store no IP at all.
IP_HASH_SECRET=
# Canonical public site URL for sitemap, metadata and email links, e.g. https://www.example.com.
SITE_URL=
