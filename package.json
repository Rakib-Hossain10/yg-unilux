{
  "name": "yg-unilux",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.1.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:indexes": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/sync-indexes.ts",
    "check:services": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/check-services.ts",
    "seed:admin": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-admin.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.1",
    "better-auth": "^1.7.7",
    "cloudinary": "^2.11.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.2",
    "lenis": "^1.3.26",
    "mongodb": "~7.6.0",
    "mongoose": "^9.10.3",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": false,
    "mongodb-memory-server": false,
    "unrs-resolver": false,
    "fsevents": false
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
